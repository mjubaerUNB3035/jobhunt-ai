<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>jobhunt_ai\cli.py</StartupFile>
    <SearchPath></SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>jobhunt-ai</Name>
    <RootNamespace>jobhunt_ai</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="jobhunt_ai\__init__.py" />
    <Compile Include="jobhunt_ai\cli.py" />
    <Compile Include="jobhunt_ai\config.py" />
    <Compile Include="jobhunt_ai\cover_letter.py" />
    <Compile Include="jobhunt_ai\matcher.py" />
    <Compile Include="jobhunt_ai\models.py" />
    <Compile Include="jobhunt_ai\sources\__init__.py" />
    <Compile Include="jobhunt_ai\sources\arbeitnow.py" />
    <Compile Include="jobhunt_ai\sources\base.py" />
    <Compile Include="jobhunt_ai\sources\local_file.py" />
    <Compile Include="jobhunt_ai\ai\__init__.py" />
    <Compile Include="jobhunt_ai\ai\base.py" />
    <Compile Include="jobhunt_ai\ai\ollama.py" />
    <Compile Include="jobhunt_ai\ai\openai_provider.py" />
    <Compile Include="jobhunt_ai\ai\rules.py" />
    <Compile Include="tests\__init__.py" />
    <Compile Include="tests\test_matcher.py" />
    <Content Include="requirements.txt" />
    <Content Include="README.md" />
    <Content Include=".env.example" />
    <Content Include="data\jobs_nb.json" />
    <Content Include="data\resume.txt" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
