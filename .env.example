# Copy this file to ".env" and fill in what you need.
# The app works with NO keys at all — the default provider is "rules" (offline).

# Which AI to use for scoring & cover letters: rules | ollama | openai
JOBHUNT_AI_PROVIDER=rules

# Only needed when JOBHUNT_AI_PROVIDER=openai (never commit a real key!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed when JOBHUNT_AI_PROVIDER=ollama (Ollama running locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
